{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "specty guard --tool claude-code"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "specty guard --tool claude-code"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "specty guard --tool claude-code"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "EnterWorktree",
      "ExitWorktree"
    ],
    "ask": [
      "ExitWorktree(action:remove)"
    ]
  }
}

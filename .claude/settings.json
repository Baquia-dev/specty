{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write|NotebookEdit|Bash|EnterWorktree",
        "hooks": [
          {
            "type": "command",
            "command": "specty guard --tool claude-code"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "specty guard --tool claude-code"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "specty guard --tool claude-code"
          }
        ]
      }
    ],
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "specty guard --tool claude-code"
          }
        ]
      }
    ],
    "WorktreeRemove": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "specty guard --tool claude-code"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|clear|compact|resume",
        "hooks": [
          {
            "type": "command",
            "command": "specty guard --tool claude-code"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "specty guard --tool claude-code"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "specty hook memory-stop claude-code"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "EnterWorktree",
      "ExitWorktree",
      "Bash(specty approve *)",
      "Bash(specty accept *)",
      "Bash(specty close *)",
      "Bash(specty cancel *)",
      "Bash(specty reject *)"
    ]
  }
}

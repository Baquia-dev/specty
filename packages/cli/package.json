{
  "name": "@baquia-dev/specty",
  "version": "0.1.0",
  "description": "Spec-driven development, enforced, for any AI coding agent.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Baquia-dev/specty.git",
    "directory": "packages/cli"
  },
  "type": "module",
  "bin": {
    "specty": "dist/specty.mjs"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "node build.mjs",
    "prepack": "pnpm --filter @baquia-dev/specty-ui build && node build.mjs --ui ../ui/dist/browser",
    "test": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json"
  },
  "devDependencies": {
    "@baquia-dev/specty-core": "workspace:*",
    "@baquia-dev/specty-exporters": "workspace:*",
    "@clack/prompts": "1.8.1",
    "commander": "15.0.0",
    "esbuild": "0.28.2",
    "jsonc-parser": "3.3.1",
    "yaml": "2.9.1"
  }
}

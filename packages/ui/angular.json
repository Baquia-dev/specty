{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "analytics": false,
    "cache": { "path": "node_modules/.cache/angular" }
  },
  "newProjectRoot": ".",
  "projects": {
    "specty-ui": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "sp",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "index": "src/index.html",
            "tsConfig": "tsconfig.json",
            "styles": ["src/styles.css"],
            "outputPath": "dist",
            "allowedCommonJsDependencies": ["picomatch/posix"]
          },
          "configurations": {
            "production": {
              "outputHashing": "all",
              "budgets": [{ "type": "initial", "maximumWarning": "500kB", "maximumError": "1MB" }]
            },
            "development": {
              "optimization": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "prebundle": { "exclude": ["@baquia-dev/specty-core"] }
          },
          "configurations": {
            "development": { "buildTarget": "specty-ui:build:development" }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "buildTarget": "specty-ui:build:development",
            "tsConfig": "tsconfig.test.json",
            "runner": "vitest",
            "include": ["src/**/*.test.ts"],
            "coverageInclude": ["src/**/*.ts"],
            "coverageExclude": ["src/**/*.test.ts", "src/main.ts"],
            "coverageReporters": ["text-summary", "lcovonly"],
            "coverageThresholds": { "lines": 80, "statements": 80, "functions": 80, "branches": 75 }
          }
        }
      }
    }
  }
}

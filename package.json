{
  "name": "specty-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Spec-driven development, enforced, for any AI coding agent.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Baquia-dev/specty.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "pnpm lint && pnpm typecheck && pnpm sources && pnpm knip && pnpm test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --workspace-concurrency=1 --if-present test",
    "sources": "node scripts/check-sources.mjs",
    "knip": "knip",
    "usage": "ccusage claude daily",
    "evals": "pnpm --filter @baquia-dev/specty build && SPECTY_EVALS=1 pnpm --filter @baquia-dev/specty-evals exec vitest run"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.5.2",
      "onFail": "download"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "5.0.5",
    "ccusage": "20.0.45",
    "fast-check": "4.10.2",
    "knip": "6.41.0",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
